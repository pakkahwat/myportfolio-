# Node dependencies
node_modules

# package-lock is intentionally not committed: npm prunes platform-specific
# optional native bindings from a lockfile generated on one OS, so a
# Windows-generated lock can break Linux CI. Without a lockfile, CI uses
# `npm install`, which resolves bindings per-OS.
package-lock.json

